# Settings for the web app (Vercel project "web-app"). These are public browser values,
# baked into the site at build time. Copy to .env.local for local development.

# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=urbangaragesale.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=urbangaragesale
VITE_FIREBASE_STORAGE_BUCKET=urbangaragesale.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps / Places browser key (restrict it to your domains in Google Cloud)
VITE_GOOGLE_PLACES_API_KEY=

# API base URL: http://localhost:3000 for local development
VITE_API_BASE_URL=https://urban-garage-sale.vercel.app
