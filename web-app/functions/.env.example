# Non-secret settings for Cloud Functions. Copy to .env (deployed with the functions).
APP_URL=https://urbangaragesales.com.au
SENDGRID_FROM_EMAIL=notification@urbangaragesales.com.au

# true once App Check is enforced for the website (see docs/DEPLOYMENT.md, App Check)
ENFORCE_APP_CHECK=false

# Automatic listing check by Claude (see docs/DEPLOYMENT.md, Automatic listing check):
#   off    - no check; the admin approves every listing
#   advise - Claude emails its verdict on every listing to ADMIN_REVIEW_EMAIL; the admin still approves
#   auto   - listings Claude passes go live; the rest are emailed to ADMIN_REVIEW_EMAIL
CLAUDE_REVIEW_MODE=off
CLAUDE_REVIEW_MODEL=claude-opus-5-5
ADMIN_REVIEW_EMAIL=admin@urbangaragesales.com.au

# Secrets are NOT stored here. Set them in Google Secret Manager:
#   npx firebase-tools functions:secrets:set STRIPE_SECRET_KEY --project urbangaragesale
#   npx firebase-tools functions:secrets:set STRIPE_WEBHOOK_SECRET --project urbangaragesale
#   npx firebase-tools functions:secrets:set SENDGRID_API_KEY --project urbangaragesale
#   npx firebase-tools functions:secrets:set ANTHROPIC_API_KEY --project urbangaragesale
