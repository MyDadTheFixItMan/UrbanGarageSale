# The root Vercel project ("urban-garage-sale") deploys only the API in api/ and public/.
# Every file under api/ becomes a public endpoint, so local-only files are excluded.
api/server.js
api/.env*
.env*

# Scripts, docs and design assets are never deployed
scripts/
*.md
Screen shots & logo/
Marketing Docs/
poster-template/

# Other apps in this repo are deployed separately (web-app has its own Vercel project)
web-app/
lib/
test/
android/
ios/
linux/
macos/
windows/
web/
build/
