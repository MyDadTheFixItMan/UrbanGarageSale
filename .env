# Stripe Configuration
# Get these from https://dashboard.stripe.com/apikeys
# Publishable Key starts with pk_test_ or pk_live_
# Secret Key starts with sk_test_ or sk_live_
# Set STRIPE_SECRET_KEY in Vercel environment variables
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
# OAuth Client ID - Get from Stripe Dashboard → Connect → Settings → Application details
STRIPE_CLIENT_ID=YOUR_STRIPE_CLIENT_ID

# Firebase Configuration
# Urban Garage Sale Firebase project settings
FIREBASE_PROJECT_ID=urbangaragesale
FIREBASE_PRIVATE_KEY_ID=YOUR_FIREBASE_PRIVATE_KEY_ID
FIREBASE_PRIVATE_KEY="YOUR_FIREBASE_PRIVATE_KEY"
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL
FIREBASE_CLIENT_ID=YOUR_FIREBASE_CLIENT_ID
FIREBASE_CLIENT_X509_CERT_URL=YOUR_FIREBASE_CLIENT_X509_CERT_URL

# Firebase Service Account
# Use FIREBASE_SERVICE_ACCOUNT_JSON via environment injection (no local key files)

# SendGrid Configuration
# Get API key from SendGrid dashboard: https://app.sendgrid.com/settings/api_keys
# Set SENDGRID_API_KEY in Vercel environment variables (NOT in this file)
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Server Configuration
PORT=3000
NODE_ENV=development
