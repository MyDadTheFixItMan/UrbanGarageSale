# Settings for the API in api/ (Vercel project "urban-garage-sale").
# In production these are set in Vercel > Project > Settings > Environment Variables.
# For local development copy this file to .env and fill in real values. Never commit .env.

# Firebase Admin service account (whole JSON on one line).
# Alternatively set FIREBASE_PROJECT_ID + FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=urbangaragesale

# Stripe secret key (sk_live_... / sk_test_...) and Connect OAuth client ID (ca_...)
STRIPE_SECRET_KEY=
STRIPE_CLIENT_ID=

# Website addresses allowed to call the API (comma separated) and used in redirects
ALLOWED_ORIGINS=https://urbangaragesales.com.au,https://www.urbangaragesales.com.au
FRONTEND_URL=https://urbangaragesales.com.au
APP_URL=https://urbangaragesales.com.au

NODE_ENV=development
PORT=3000
