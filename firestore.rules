rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True only if this sign-in completed Firebase's SMS second factor. Firebase writes
    // sign_in_second_factor into the signed ID token; clients cannot add it.
    function hasSecondFactorSession() {
      return signedIn() && request.auth.token.firebase.get('sign_in_second_factor', null) != null;
    }

    // Admin access requires a 2FA session, so a stolen admin password alone is not enough.
    // The `admin` custom claim is set only server-side, by the setUserRole function or
    // scripts/sync-admin-claims.mjs, so no document read is needed.
    function isAdmin() {
      return hasSecondFactorSession() && request.auth.token.get('admin', false) == true;
    }

    // two_fa_enabled is set by the API (api/setUserClaims.ts) once an SMS second factor is
    // enrolled; the session must also have passed that second factor.
    function has2FAEnabled() {
      return hasSecondFactorSession() && request.auth.token.get('two_fa_enabled', false) == true;
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // ---------- Field validation ----------
    // `keys` is the set of fields this write touches: data.keys() on create,
    // diff().affectedKeys() on update, so older documents with legacy fields can still be edited.
    // Each check passes when the field isn't part of the write. `d` is request.resource.data,
    // passed in because a listing write with every field changed is close to Firestore's limit of
    // 1000 expressions per request, and looking it up in each check uses up several times more.
    function changedKeys() {
      return resource == null ? request.resource.data.keys()
                              : request.resource.data.diff(resource.data).affectedKeys();
    }

    function isText(d, keys, field, max) {
      return !keys.hasAny([field]) ||
             (d[field] is string && d[field].size() <= max);
    }

    function isTextOrNull(d, keys, field, max) {
      return !keys.hasAny([field]) || d[field] == null ||
             (d[field] is string && d[field].size() <= max);
    }

    function matchesOrEmpty(d, keys, field, pattern) {
      return !keys.hasAny([field]) ||
             (d[field] is string &&
              (d[field] == '' || d[field].matches(pattern)));
    }

    function isCoordinateOrNull(d, keys, field, limit) {
      return !keys.hasAny([field]) || d[field] == null ||
             (d[field] is number &&
              d[field] >= -limit && d[field] <= limit);
    }

    function isBool(d, keys, field) {
      return !keys.hasAny([field]) || d[field] is bool;
    }

    // At most 5 Firebase download URLs (the website's limit, MAX_PHOTOS) from the seller's own
    // Storage folder, so a listing can't show or claim anyone else's files. A thumbnail is null
    // when one couldn't be made.
    function isPhotoList(d, keys, field) {
      return !keys.hasAny([field]) ||
             (d[field] is list && d[field].size() <= 5 &&
              d[field].removeAll([null]).join(' ').matches(
                '(https://firebasestorage[.]googleapis[.]com/v0/b/[^/ ]+/o/listings%2F' + request.auth.uid + '%2F[^ ]+ ?)*'));
    }

    // The limits on the listing form: at most 3 days long (MAX_SALE_DAYS), and not years away, so
    // one listing can't stay up indefinitely. Only a draft can leave them blank, because
    // expireListings ends a sale by its end_date. Ending a sale needs no dates.
    function validSaleDates(d, keys) {
      let start = d.get('start_date', '');
      let end = d.get('end_date', '');
      let status = d.get('status', 'draft');
      return !keys.hasAny(['start_date', 'end_date', 'status']) || status == 'completed' ||
             (status == 'draft' && (start == '' || end == '')) ||
             (start != '' && end != '' && end >= start &&
              timestamp.value(end + 'T00:00:00Z') <= timestamp.value(start + 'T00:00:00Z') + duration.value(2, 'd') &&
              timestamp.value(end + 'T00:00:00Z') <= request.time + duration.value(400, 'd'));
    }

    // A real date, no further ahead than a device with a wrong clock could put the 2-day expiry.
    function validDraftExpiry(d, keys) {
      return isTextOrNull(d, keys, 'draft_expires_at', 40) &&
             (!keys.hasAny(['draft_expires_at']) || d.draft_expires_at == null ||
              timestamp.value(d.draft_expires_at) <= request.time + duration.value(7, 'd'));
    }

    // Fields a user may write on their own profile (protected fields are checked separately).
    function validUserProfile() {
      let d = request.resource.data;
      let keys = changedKeys();
      return keys.hasOnly(['email', 'full_name', 'address', 'phone', 'phone_verified',
                           'suburb', 'postcode', 'state', 'created_date', 'role']) &&
             isText(d, keys, 'email', 254) && isText(d, keys, 'full_name', 100) &&
             isText(d, keys, 'address', 300) && isText(d, keys, 'suburb', 100) && isText(d, keys, 'phone', 20) &&
             matchesOrEmpty(d, keys, 'postcode', '^[0-9]{4}$') && isText(d, keys, 'state', 3) &&
             isText(d, keys, 'created_date', 40) && isBool(d, keys, 'phone_verified');
    }

    // Fields a seller may write on their own listing. Status, payment and ownership rules are
    // in the match block below; this checks shape and size.
    function validListing() {
      let d = request.resource.data;
      let keys = changedKeys();
      return keys.hasOnly(['title', 'description', 'address', 'suburb', 'postcode', 'state',
                           'latitude', 'longitude', 'geohash', 'start_date', 'end_date',
                           'start_time', 'end_time', 'sale_type', 'photos', 'thumbnails',
                           'status', 'payment_status', 'draft_expires_at', 'user_id', 'created_at']) &&
             isText(d, keys, 'title', 150) && isText(d, keys, 'description', 5000) &&
             isText(d, keys, 'address', 300) && isText(d, keys, 'suburb', 100) &&
             matchesOrEmpty(d, keys, 'postcode', '^[0-9]{4}$') && isText(d, keys, 'state', 3) &&
             isCoordinateOrNull(d, keys, 'latitude', 90) && isCoordinateOrNull(d, keys, 'longitude', 180) &&
             isText(d, keys, 'geohash', 12) &&
             matchesOrEmpty(d, keys, 'start_date', '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') &&
             matchesOrEmpty(d, keys, 'end_date', '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$') && validSaleDates(d, keys) &&
             matchesOrEmpty(d, keys, 'start_time', '^[0-9]{2}:[0-9]{2}$') &&
             matchesOrEmpty(d, keys, 'end_time', '^[0-9]{2}:[0-9]{2}$') &&
             isText(d, keys, 'sale_type', 30) &&
             isPhotoList(d, keys, 'photos') && isPhotoList(d, keys, 'thumbnails') &&
             validDraftExpiry(d, keys) &&
             (!keys.hasAny(['created_at']) || d.created_at is timestamp);
    }

    // ---------- Users ----------
    // Fields only the server (Admin SDK) or an admin may set.
    function protectedUserFields() {
      return ['role', 'two_fa_enabled', 'two_fa_enabled_date', 'two_fa_disabled_date',
              'cardPaymentsEnabled', 'stripeConnectId', 'stripeAccountType', 'stripeConnectSetup',
              'stripeBusinessName', 'stripeBusinessType', 'stripeCountry', 'stripeEmail', 'linkedAt'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());

      // New profiles may only claim the default 'user' role.
      allow create: if signedIn() && request.auth.uid == userId &&
                       request.resource.data.get('role', 'user') == 'user' &&
                       !request.resource.data.keys().hasAny(protectedUserFields().removeAll(['role'])) &&
                       validUserProfile();

      // Roles change only through the setUserRole function, which sets the admin claim and
      // writes the audit log.
      allow update: if (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) ||
                       (signedIn() && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields()) &&
                        validUserProfile());

      allow delete: if isAdmin();
    }

    // ---------- Garage sale listings ----------
    // A listing qualifies as free when the admin's free period is on and the sale starts inside it.
    // Free listings wait for admin approval like paid ones, so sellers can never publish directly.
    function isFreeListing(data) {
      let settings = get(/databases/$(database)/documents/appSettings/default).data;
      return data.get('status', '') == 'pending_approval' &&
             data.get('payment_status', '') == 'completed' &&
             settings.get('is_active', false) == true &&
             data.get('start_date', '') is string &&
             data.start_date >= settings.get('free_listing_start', '9999') &&
             data.start_date <= settings.get('free_listing_end', '');
    }

    // Once a listing is paid for or approved, the seller can change only what buyers read and see,
    // so one fee (or one free-period listing) can't be moved to another weekend or address. A live
    // listing's content changes only when an admin approves an edit (see listingEdits below).
    function isPaidOrApproved(data) {
      return data.get('status', '') in ['active', 'pending_approval'] ||
             data.get('payment_status', '') in ['paid', 'completed', 'free'];
    }

    // Status stays allowed because the rule below lets a seller end their own sale.
    function paidListingChangeAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        resource.data.get('status', '') == 'active'
          ? ['status']
          : ['title', 'description', 'sale_type', 'photos', 'thumbnails', 'status']);
    }

    // Unpaid listings the owner controls. Paid/approved states are set by the server or an admin.
    function isUnpaidOwnerState(data) {
      return data.get('status', 'draft') in ['draft', 'pending_payment'] &&
             data.get('payment_status', 'pending') == 'pending';
    }

    match /garageSales/{saleId} {
      // The public sees live listings only. Drafts, unpaid, pending and rejected listings are
      // visible to their owner and admins. Public queries must filter on status == 'active'.
      allow read: if resource.data.get('status', '') == 'active' ||
                     (signedIn() && request.auth.uid == resource.data.get('user_id', '')) ||
                     isAdmin();

      // Listings are public, so they must not carry the seller's email address.
      allow create: if has2FAEnabled() &&
                       request.resource.data.user_id == request.auth.uid &&
                       !('created_by' in request.resource.data) &&
                       validListing() &&
                       (isUnpaidOwnerState(request.resource.data) || isFreeListing(request.resource.data));

      allow update: if isAdmin() ||
                       (signedIn() && request.auth.uid == resource.data.user_id &&
                        unchanged('user_id') && unchanged('created_by') && unchanged('is_free_listing') &&
                        validListing() &&
                        (!isPaidOrApproved(resource.data) || paidListingChangeAllowed()) &&
                        (
                          // Ordinary edits that leave the status alone
                          (unchanged('status') && unchanged('payment_status')) ||
                          // Owner ends their own sale
                          (request.resource.data.get('status', '') == 'completed' && unchanged('payment_status')) ||
                          // Moving between unpaid states (e.g. draft -> pending_payment)
                          (isUnpaidOwnerState(resource.data) && isUnpaidOwnerState(request.resource.data)) ||
                          // Free-period submission of a listing that was never paid for
                          (resource.data.get('payment_status', 'pending') == 'pending' && isFreeListing(request.resource.data))
                        ));

      allow delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.user_id);
    }

    // ---------- Changes to live listings ----------
    // A seller's proposed title, description, sale type and photos, one per listing, stored apart
    // from the public listing so buyers only ever see what an admin approved. An admin approves
    // by copying them onto the listing; refusing (Cloud Function) marks them refused with a reason.
    function validListingEdit() {
      let d = request.resource.data;
      let keys = d.keys();
      return keys.hasOnly(['user_id', 'title', 'description', 'sale_type', 'photos', 'thumbnails',
                           'status', 'submitted_at']) &&
             keys.hasAll(['user_id', 'title', 'status', 'submitted_at']) &&
             d.status == 'pending' &&
             d.submitted_at is timestamp &&
             isText(d, keys, 'title', 150) && isText(d, keys, 'description', 5000) &&
             isText(d, keys, 'sale_type', 30) &&
             isPhotoList(d, keys, 'photos') && isPhotoList(d, keys, 'thumbnails');
    }

    match /listingEdits/{saleId} {
      function sellerOfLiveListing() {
        let sale = get(/databases/$(database)/documents/garageSales/$(saleId)).data;
        return sale.get('user_id', '') == request.auth.uid && sale.get('status', '') == 'active';
      }

      // A seller's edit page asks whether an edit is waiting, so "there isn't one" must be an
      // answer rather than a refusal. A missing edit reveals nothing.
      allow read: if isAdmin() || (signedIn() && (resource == null || request.auth.uid == resource.data.user_id));
      allow create, update: if signedIn() && request.auth.uid == request.resource.data.user_id &&
                               sellerOfLiveListing() && validListingEdit();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == resource.data.user_id);
    }

    // ---------- Saved listings ----------
    match /savedListings/{savedId} {
      allow read, delete: if signedIn() && request.auth.uid == resource.data.user_id;
      // Only approved listings can be saved. Removing a favourite is always allowed, so one whose
      // listing has since ended or been rejected can still be cleared.
      allow create: if signedIn() && request.auth.uid == request.resource.data.user_id &&
                       request.resource.data.keys().hasOnly(['garage_sale_id', 'user_id', 'created_at']) &&
                       get(/databases/$(database)/documents/garageSales/$(request.resource.data.garage_sale_id)).data.get('status', '') == 'active';
    }

    // ---------- Listing fee payments ----------
    // Paid records are written by Cloud Functions after Stripe confirms the payment.
    // Clients may only record a $0 free-period entry for their own free listing.
    match /payments/{paymentId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.get('user_id', '') || isAdmin());

      allow create: if isAdmin() ||
                       (signedIn() &&
                        request.resource.data.keys().hasOnly(['garage_sale_id', 'user_id', 'user_email', 'amount', 'currency',
                                                              'status', 'payment_method', 'created_at']) &&
                        request.resource.data.user_id == request.auth.uid &&
                        request.resource.data.amount == 0 &&
                        request.resource.data.payment_method == 'free_period' &&
                        request.resource.data.status == 'completed' &&
                        get(/databases/$(database)/documents/garageSales/$(request.resource.data.garage_sale_id)).data.user_id == request.auth.uid &&
                        get(/databases/$(database)/documents/garageSales/$(request.resource.data.garage_sale_id)).data.payment_status == 'completed');

      allow update, delete: if isAdmin();
    }

    // ---------- Contact messages ----------
    // Rate limit: a user may send one contact message per minute. The message and this marker
    // are written in one batch, and the message is accepted only if the marker was updated in
    // that same write (getAfter), names this message, and the previous one is at least 60 seconds
    // old. Naming the message stops one marker covering a whole batch of messages.
    // Replies go to `email`, so it must be the sender's own verified address.
    match /contactRateLimits/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid &&
                               request.resource.data.keys().hasOnly(['last', 'messageId']) &&
                               request.resource.data.last == request.time &&
                               request.resource.data.messageId is string &&
                               (resource == null || request.time > resource.data.last + duration.value(60, 's'));
    }

    match /contactMessages/{messageId} {
      allow create: if signedIn() &&
                       request.resource.data.keys().hasOnly(['name', 'email', 'message', 'user_id', 'status', 'created_at']) &&
                       request.resource.data.user_id == request.auth.uid &&
                       request.resource.data.status == 'unread' &&
                       request.resource.data.created_at == request.time &&
                       request.resource.data.name is string && request.resource.data.name.size() <= 100 &&
                       request.auth.token.get('email_verified', false) == true &&
                       request.resource.data.email == request.auth.token.email &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 4000 &&
                       getAfter(/databases/$(database)/documents/contactRateLimits/$(request.auth.uid)).data.last == request.time &&
                       getAfter(/databases/$(database)/documents/contactRateLimits/$(request.auth.uid)).data.messageId == messageId;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Site content and settings ----------
    match /promotions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appSettings/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /admin_settings/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /postcode_cache/{document=**} {
      allow read: if true;
      allow write: if false; // Admin SDK only
    }

    // ---------- Urban Pay ----------
    // Sales and stats are written only by the API (Admin SDK) so totals cannot be edited
    // from the browser: cash via /api/urbanPayment/recordSale, card via recordTapToPaySale
    // after Stripe confirms the payment.
    match /sales/{saleId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
      allow write: if isAdmin();
    }

    match /sellerStats/{sellerId} {
      allow read: if signedIn() && (request.auth.uid == sellerId || isAdmin());
      allow write: if isAdmin();
    }

    match /saleStats/{garageSaleId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.sellerId || isAdmin());
      allow write: if isAdmin();
    }

    // oauth_states, auditLog, rateLimits, terminalLocations and anything not listed above: no client access
    // (Admin SDK only).
  }
}
